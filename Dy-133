
#include <stdio.h>

int main() {
    int n, num, sum = 0;

    printf("Enter how many numbers: ");
    scanf("%d", &n);

    for(int i = 1; i <= n; i++) {
        printf("Enter number: ");
        scanf("%d", &num);

        sum = sum + num;

        printf("Running Total = %d\n", sum);
    }

    return 0;
}
