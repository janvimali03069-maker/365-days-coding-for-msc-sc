
#include <stdio.h>

int main() {
    int choice;

    printf("=== Dark Web Simulation ===\n");
    printf("1. Connect to Anonymous Network\n");
    printf("2. Visit Hidden Website\n");
    printf("3. Exit\n");

    printf("Enter your choice: ");
    scanf("%d", &choice);

    switch (choice) {
        case 1:
            printf("Connecting to simulated network...\n");
            printf("Connection successful!\n");
            break;

        case 2:
            printf("Opening fictional hidden website...\n");
            printf("Welcome to the demo website!\n");
            break;

        case 3:
            printf("Exiting program...\n");
            break;

        default:
            printf("Invalid choice!\n");
    }

    return 0;
}
