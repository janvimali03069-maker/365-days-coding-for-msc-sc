#include <stdio.h>

int main() {
    int nums[] = {-2, -1, 2, 3};
    int n = 4;
    int ans[4];
    int temp;

    // Step 1: Find squares
    for (int i = 0; i < n; i++) {
        ans[i] = nums[i] * nums[i];
    }

    // Step 2: Sort the squared values
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (ans[i] > ans[j]) {
                temp = ans[i];
                ans[i] = ans[j];
                ans[j] = temp;
            }
        }
    }

    // Step 3: Print output
    printf("Output: ");

    for (int i = 0; i < n; i++) {
        printf("%d ", ans[i]);
    }

    return 0;
}
