#include<stdio.h>
int main()
{
int a,b,i,temp;
int count=0,sum=0,largest;
printf("Enter a and b:");
scanf("%d %d",&a,&b);
if(a>b)
{
temp=a;
a=b;
b=temp;
}
for(i=a; i<=b; i++)
{
if(i%4==0&&i%6==1)
{
printf("%d",i);
count++;
sum+=i;
if(count==1||i>largest)
largest=i;
}
}
if(count==0)
{
printf("\nNo such number.");
}
else{
printf("\nCount=%d",count);
printf("\nSum=%d",sum);
printf("\nLargest=%d",largest);
}
return 0;
}
