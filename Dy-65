#include <stdio.h>
#include <string.h>

int main() {
    char password[20];
    char confirm[20];

    printf("Set your password: ");
    scanf("%19s", password);

    printf("Confirm your password: ");
    scanf("%19s", confirm);

    if (strcmp(password, confirm) == 0) {
        printf("Password set successfully!\n");
    } else {
        printf("Passwords do not match.\n");
    }

    return 0;
}