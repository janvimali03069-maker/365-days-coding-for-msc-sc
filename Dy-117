
#include <stdio.h>
#define SIZE 10

int hashTable[SIZE];

void insert(int key) {
    int index = key % SIZE;

    while (hashTable[index] != -1) {
        index = (index + 1) % SIZE;
    }

    hashTable[index] = key;
}

void display() {
    int i;

    printf("\nHash Table:\n");
    for (i = 0; i < SIZE; i++) {
        printf("Index %d: %d\n", i, hashTable[i]);
    }
}

int main() {
    int i, n, key;

    for (i = 0; i < SIZE; i++) {
        hashTable[i] = -1;
    }

    printf("Enter number of elements (max 10): ");
    scanf("%d", &n);

    if (n < 0 || n > SIZE) {
        printf("Invalid number of elements!\n");
        return 1;
    }

    for (i = 0; i < n; i++) {
        printf("Enter key: ");
        scanf("%d", &key);
        insert(key);
    }

    display();

    return 0;
}
