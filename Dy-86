#include<stdio.h>
int main()
{
int nums[]={-2,-1,2,3};
int n=4;intans[4];
int L=0;
int H=n-1;
int w=n-1;
while(L<=H)
{
if(nums[L]*nums[L]>nums[H]*nums[H])
{
ans[w]=nums[L]*nums[L];
L++;
}
else{
ans[w]=nums[H]*nums[H];
H--;
}
w--;
}
printf("Output: ");
for(int i=0; i<n; i++)
{
printf("%d",ans[i]);
}
return 0;
}
