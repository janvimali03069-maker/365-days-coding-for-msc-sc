
#include <stdio.h>
#include <string.h>

int main() {
    char str[100][100];
    int n, i, j;
    
    printf("Enter number of strings: ");
    scanf("%d", &n);

    printf("Enter strings:\n");
    for (i = 0; i < n; i++) {
        scanf("%s", str[i]);
    }

    for (i = 0; str[0][i] != '\0'; i++) {
        for (j = 1; j < n; j++) {
            if (str[j][i] != str[0][i]) {
                break;
            }
        }
        if (j < n) {
            break;
        }
    }

    str[0][i] = '\0';

    printf("Longest Common Prefix: %s\n", str[0]);

    return 0;
}
