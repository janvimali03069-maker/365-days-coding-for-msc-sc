import random

text = input("Enter your message: ")

colors = [
    "\033[91m",  # Red
    "\033[92m",  # Green
    "\033[93m",  # Yellow
    "\033[94m",  # Blue
    "\033[95m",  # Purple
    "\033[96m"   # Cyan
]

reset = "\033[0m"

for char in text:
    if char != " ":
        color = random.choice(colors)
        print(color + char + reset, end=" ")
    else:
        print(" ", end=" ")

print()
